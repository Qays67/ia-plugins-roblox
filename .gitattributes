# Normalise les fins de ligne en LF.
# Sans cela, un clone sur Windows (core.autocrlf=true) transformerait les
# fichiers livres en CRLF, et la CI croirait a tort que dist/ n'est pas a jour.
* text=auto eol=lf

*.rbxmx text eol=lf
*.luau text eol=lf
*.mjs text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
